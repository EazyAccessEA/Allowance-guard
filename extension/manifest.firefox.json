{
  "manifest_version": 2,
  "name": "AllowanceGuard — Wallet Protection",
  "version": "2.0.0",
  "description": "Pre-transaction protection: detect risky approve(), permit(), and setApprovalForAll() calls before you sign",
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@allowanceguard.com",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "https://*.allowanceguard.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "AllowanceGuard",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": ["icons/*.png"],
  "content_security_policy": "script-src 'self'; object-src 'self';"
}
