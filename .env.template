# Allowance Guard Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER commit actual environment variables to version control

# ——— App ———
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ——— Database ———
DATABASE_URL=postgresql://username:password@localhost:5432/allowance_guard

# ——— Redis (optional) ———
REDIS_URL=redis://localhost:6379

# ——— Email (choose ONE: Postmark OR SMTP) ———
# Postmark (recommended)
POSTMARK_SERVER_TOKEN=your_postmark_token_here
MAIL_FROM=Allowance Guard <support@yourdomain.com>

# OR SMTP (alternative)
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your_email@yourdomain.com
# SMTP_PASS=your_app_password

# ——— Stripe (donations) ———
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ——— Coinbase Commerce (crypto donations) ———
COINBASE_COMMERCE_API_KEY=your_coinbase_api_key
COINBASE_COMMERCE_WEBHOOK_SECRET=your_webhook_secret

# ——— RPC URLs ———
ETHEREUM_RPC_URLS=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URLS=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URLS=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# ——— Monitoring ———
ROLLBAR_ACCESS_TOKEN=your_rollbar_server_token
NEXT_PUBLIC_ROLLBAR_ACCESS_TOKEN=your_rollbar_client_token

# ——— Security ———
BETTER_AUTH_SECRET=your_32_character_random_secret

# ——— WalletConnect ———
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ——— Ops Monitoring (optional) ———
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
OPS_ALERT_EMAIL=alerts@yourdomain.com
OPS_DASH_TOKEN=your_secure_random_token
