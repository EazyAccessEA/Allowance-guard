# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.template
production.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Security - Sensitive files that should never be public
# Environment and configuration files
.env*
production.env.example
*.env.production
*.env.local
*.env.development

# Secrets and keys
*.key
*.pem
*.p12
*.pfx
*.secret
.secrets/
config/secrets/
*.private

# Deployment files with sensitive info
scripts/deploy-*.sh
deployment/
deploy/

# Database files
*.db
*.sqlite
*.sqlite3
*.dump

# Logs
*.log
logs/
log/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
.nyc_output/

# Build outputs
.next/
out/
build/
dist/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# Temporary files
*.tmp
*.temp
.tmp/
.temp/

# Backup files
*.backup
*.bak
.backup/
backup/

# Documentation with sensitive info (add specific files as needed)
# PRODUCTION_DEPLOYMENT_CHECKLIST.md
# VERCEL_DEPLOYMENT.md
