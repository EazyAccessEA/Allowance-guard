# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
**/.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenAPI → client types (regenerate with pnpm run generate:openapi)
packages/client/src/types.generated.ts

# Claude scratch / in-flight task notes. Tracked skeleton only (.gitkeep).
# Security engineer (#4) veto: scratch notes often contain tokens/URLs/paste-dumps.
context/*
!context/.gitkeep

# Claude Code session state + auto-memory. Root-level MEMORY.md is the
# operator's personal auto-memory, .agents/ holds cloned external skills
# managed via skills-lock.json, .continue/ is the Continue extension's
# cache. None belong in the repo.
MEMORY.md
.agents/
.continue/

# Workspace package build outputs — regenerated by pnpm -F <pkg> build.
packages/*/dist/
packages/*/node_modules/
