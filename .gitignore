# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
**/.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenAPI → client types (regenerate with pnpm run generate:openapi)
packages/client/src/types.generated.ts

# Claude scratch / in-flight task notes. Tracked skeleton only (.gitkeep).
# Security engineer (#4) veto: scratch notes often contain tokens/URLs/paste-dumps.
context/*
!context/.gitkeep

# Claude Code session state + auto-memory. Root-level MEMORY.md is the
# operator's personal auto-memory, .agents/ holds cloned external skills
# managed via skills-lock.json, .continue/ is the Continue extension's
# cache. None belong in the repo.
MEMORY.md
.agents/
.continue/

# Workspace package build outputs — regenerated by pnpm -F <pkg> build.
packages/*/dist/
packages/*/node_modules/

# --------------------------------------------------------------------------
# Internal working files — Standing Council consensus 2026-04-19.
# Hidden from the public repo because they describe: (a) how we iterate
# (agent runbooks), (b) commercial strategy (BUSINESS.md), (c) vendor /
# finance / incident / legal-calibration working notes (memory/). These
# stay on the operator's machine and are not distributed via the open-
# source repo. Source code, public-facing docs, ADRs, and architecture
# notes remain public for contributors.
# --------------------------------------------------------------------------
memory/
projects/allowanceguard/BUSINESS.md
docs/admin-ops-agents.md
docs/compliance-risk-agents.md
docs/data-intelligence-agents.md
docs/design-agents.md
docs/growth-agents.md
docs/marketing-agents.md
docs/product-engineering-agents.md
docs/council-voice-bible.md
docs/archive/
.claude/settings.json
skills-lock.json
CLAUDE.md
