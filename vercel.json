{
  "regions": ["lhr1"],
  "crons": [
    {
      "path": "/api/monitor/cron",
      "schedule": "*/15 * * * *"
    }
  ],
  "functions": {
    "app/**/route.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/alerts/daily",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
