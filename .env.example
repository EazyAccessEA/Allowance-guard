# =============================================================================
# AllowanceGuard — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/allowanceguard

# ---------------------------------------------------------------------------
# Upstash Serverless Redis — rate limiting, metrics, cache
# https://upstash.com/
#
# Both values unset → rate limiting is disabled (fail open), metrics are
# dropped, and the cache layer falls back to the Postgres `cache` table.
# Both values set → all three modules use Upstash. A transient Upstash
# outage fails CLOSED on the rate limiter (security posture) and falls
# back to Postgres on the cache layer.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Stripe — Payments & Billing
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: separate secret for billing-specific webhook endpoint
STRIPE_BILLING_WEBHOOK_SECRET=whsec_...

# Consumer plan Stripe Price IDs (create in Stripe Dashboard > Products)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_SENTINEL_MONTHLY=price_...
STRIPE_PRICE_SENTINEL_YEARLY=price_...

# API plan Stripe Price IDs
STRIPE_PRICE_API_DEVELOPER=price_...
STRIPE_PRICE_API_GROWTH=price_...

# ---------------------------------------------------------------------------
# Coinbase Commerce — Donations
# ---------------------------------------------------------------------------
COINBASE_COMMERCE_API_KEY=

# ---------------------------------------------------------------------------
# WalletConnect / Reown
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — bot verification on the waitlist form
# https://developers.cloudflare.com/turnstile/
#
# Both values unset → Turnstile is disabled. Widget renders nothing and
# server-side verification short-circuits to true (dev fallback).
# Both values set → widget mounts on /coming-soon, token is required.
#
# For local testing Cloudflare provides always-pass test keys:
#   Site:   1x00000000000000000000AA
#   Secret: 1x0000000000000000000000000000000AA
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# App URL
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://www.allowanceguard.com

# ---------------------------------------------------------------------------
# Email (Resend preferred; Postmark and SMTP supported as fallbacks)
# ---------------------------------------------------------------------------
# Option 1 (preferred): Resend — https://resend.com
RESEND_API_KEY=

# Option 2: Postmark
POSTMARK_SERVER_TOKEN=

# Option 3: SMTP (e.g. Microsoft Outlook)
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERTS_FROM_EMAIL=no_reply@allowanceguard.com
ALERTS_FROM_NAME=Allowance Guard

# ---------------------------------------------------------------------------
# Monitoring & Error Tracking
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
ROLLBAR_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# E2E Testing Flags
# ---------------------------------------------------------------------------
# E2E_FAKE_PAYMENTS=true    # Skip Stripe/Coinbase in tests
# E2E_FAKE_EMAIL=true       # Skip email sending in tests
