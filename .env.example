# =============================================================================
# AllowanceGuard — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/allowanceguard

# ---------------------------------------------------------------------------
# Redis (Upstash or self-hosted)
# ---------------------------------------------------------------------------
REDIS_URL=redis://default:password@host:6379
# Or use individual fields:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ---------------------------------------------------------------------------
# Stripe — Payments & Billing
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: separate secret for billing-specific webhook endpoint
STRIPE_BILLING_WEBHOOK_SECRET=whsec_...

# Consumer plan Stripe Price IDs (create in Stripe Dashboard > Products)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_SENTINEL_MONTHLY=price_...
STRIPE_PRICE_SENTINEL_YEARLY=price_...

# API plan Stripe Price IDs
STRIPE_PRICE_API_DEVELOPER=price_...
STRIPE_PRICE_API_GROWTH=price_...

# ---------------------------------------------------------------------------
# Coinbase Commerce — Donations
# ---------------------------------------------------------------------------
COINBASE_COMMERCE_API_KEY=

# ---------------------------------------------------------------------------
# WalletConnect / Reown
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# App URL
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://www.allowanceguard.com

# ---------------------------------------------------------------------------
# Email (Resend preferred; Postmark and SMTP supported as fallbacks)
# ---------------------------------------------------------------------------
# Option 1 (preferred): Resend — https://resend.com
RESEND_API_KEY=

# Option 2: Postmark
POSTMARK_SERVER_TOKEN=

# Option 3: SMTP (e.g. Microsoft Outlook)
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERTS_FROM_EMAIL=no_reply@allowanceguard.com
ALERTS_FROM_NAME=Allowance Guard

# ---------------------------------------------------------------------------
# Monitoring & Error Tracking
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
ROLLBAR_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# E2E Testing Flags
# ---------------------------------------------------------------------------
# E2E_FAKE_PAYMENTS=true    # Skip Stripe/Coinbase in tests
# E2E_FAKE_EMAIL=true       # Skip email sending in tests
