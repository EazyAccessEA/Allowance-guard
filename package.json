    "rollbar": "^2.26.4",
    "speakeasy": "^2.0.0",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "three": "^0.183.2",
    "vanta": "^0.5.24",
    "viem": "^2.37.4",
    "wagmi": "^2.16.9",
    "web-vitals": "^5.1.0",
    "zod": "^4.1.5"
