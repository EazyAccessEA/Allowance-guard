{
  "name": "allowance-guard",
  "version": "1.14.9",
  "description": "Secure token approval monitoring and management platform",
  "private": true,
  "author": "Allowance Guard Team",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://www.allowanceguard.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/EazyAccessEA/Allowance-guard"
  },
  "keywords": [
    "defi",
    "token-approvals",
    "blockchain-security",
    "wallet-monitoring",
    "ethereum",
    "arbitrum",
    "base"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm --filter @allowance-guard/client build && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "migrate:status": "tsx scripts/migrate.ts status",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "test:smtp": "tsx scripts/test-smtp.ts",
    "test:ops": "node scripts/test-ops-monitoring.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy:prod": "bash scripts/deploy-production.sh",
    "analyze": "cross-env ANALYZE=true next build",
    "networks:update": "node scripts/update-networks-changelog.js"
  },
